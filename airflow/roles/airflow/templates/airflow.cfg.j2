{# Apache Airflow configuration - generated by Ansible #}
[core]
dags_folder = {{ airflow_dags_folder }}
executor = {{ airflow_executor }}
parallelism = {{ airflow_parallelism }}
max_active_tasks_per_dag = {{ airflow_max_active_tasks_per_dag }}
dags_are_paused_at_creation = True
dag_dir_list_interval = 300
fernet_key = {{ airflow_fernet_key_effective }}
donot_pickle = True
load_examples = {{ airflow_load_examples | string | lower }}
default_timezone = {{ airflow_default_timezone }}

[database]
sql_alchemy_conn = {{ airflow_db_conn }}
sql_engine_encoding = utf-8
sql_engine_pool_recycle = 1800
sql_engine_pool_size = 5
sql_engine_pool_max_overflow = 10

[scheduler]
max_active_tasks_per_dag = {{ airflow_max_active_tasks_per_dag }}
max_active_runs_per_dag = {{ airflow_max_active_runs_per_dag }}
catchup_by_default = False
min_file_process_interval = 2
job_heartbeat_sec = 5
scheduler_heartbeat_sec = 5

[webserver]
base_url = {{ airflow_webserver_base_url }}
default_ui_timezone = {{ airflow_default_timezone }}
secret_key = {{ airflow_webserver_secret_effective }}
instance_name = Airflow Staging
web_server_host = {{ airflow_web_server_host }}
web_server_port = {{ airflow_webserver_port }}
enable_proxy_fix = True
cookie_samesite = Lax
session_lifetime_days = 1

[logging]
base_log_folder = {{ airflow_logs_dir }}
remote_logging = False
logging_level = INFO

[api]
auth_backends = airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
max_content_length = 100000000

[operators]
default_owner = {{ airflow_admin_user }}

[metrics]
statsd_on = False
