# SonarQube Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

#--------------------------------------------------------------------------------------------------
# DATABASE
#
# IMPORTANT:
# - The embedded H2 database is used by default. It is recommended for tests only.
# - Supported databases: PostgreSQL, Microsoft SQL Server, Oracle

{% if sonarqube_db_type == "postgresql" %}
sonar.jdbc.url=jdbc:postgresql://{{ sonarqube_db_host }}:{{ sonarqube_db_port }}/{{ sonarqube_db_name }}
sonar.jdbc.username={{ sonarqube_db_user }}
sonar.jdbc.password={{ sonarqube_db_password }}
{% else %}
sonar.jdbc.url=jdbc:h2:tcp://127.0.0.1:9092/sonar
sonar.jdbc.username=sonar
sonar.jdbc.password=sonar
{% endif %}

#--------------------------------------------------------------------------------------------------
# WEB SERVER

# Binding address and port
sonar.web.host={{ sonarqube_web_host }}
sonar.web.port={{ sonarqube_web_port }}
sonar.web.context={{ sonarqube_web_context }}

#--------------------------------------------------------------------------------------------------
# ELASTICSEARCH

sonar.search.host={{ sonarqube_es_host }}
sonar.search.port={{ sonarqube_es_port }}

#--------------------------------------------------------------------------------------------------
# PATHS

sonar.path.data={{ sonarqube_data_dir }}
sonar.path.temp={{ sonarqube_temp_dir }}
sonar.path.logs={{ sonarqube_log_dir }}

#--------------------------------------------------------------------------------------------------
# JAVA

sonar.web.javaOpts={{ sonarqube_web_java_opts }}
sonar.ce.javaOpts={{ sonarqube_ce_java_opts }}
sonar.search.javaOpts={{ sonarqube_es_java_opts }}
