{# Confluent Platform (Community Edition) - generated by Ansible #}
{# All components on a single Docker host, KRaft mode (no ZooKeeper) #}
services:
  kafka:
    # cp-server (Confluent Server) is required for the Control Center Next-Gen
    # telemetry pipeline (TelemetryReporter class is not in cp-kafka).
    image: {{ confluent_image_repo_prefix }}/cp-server:{{ confluent_version }}
    container_name: kafka
    hostname: kafka
    restart: unless-stopped
    ports:
      - "{{ confluent_kafka_port_host }}:{{ confluent_kafka_port_host }}"
    environment:
      KAFKA_NODE_ID: "{{ confluent_kafka_node_id }}"
      CLUSTER_ID: "{{ confluent_cluster_id }}"
      KAFKA_PROCESS_ROLES: "broker,controller"
      KAFKA_CONTROLLER_QUORUM_VOTERS: "{{ confluent_kafka_node_id }}@kafka:{{ confluent_kafka_controller_port }}"
      KAFKA_CONTROLLER_LISTENER_NAMES: "CONTROLLER"
      KAFKA_LISTENERS: "PLAINTEXT://0.0.0.0:{{ confluent_kafka_port_internal }},CONTROLLER://0.0.0.0:{{ confluent_kafka_controller_port }},PLAINTEXT_HOST://0.0.0.0:{{ confluent_kafka_port_host }}"
      KAFKA_ADVERTISED_LISTENERS: "PLAINTEXT://kafka:{{ confluent_kafka_port_internal }},PLAINTEXT_HOST://{{ confluent_advertised_host }}:{{ confluent_kafka_port_host }}"
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT"
      KAFKA_INTER_BROKER_LISTENER_NAME: "PLAINTEXT"
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: "{{ confluent_kafka_offsets_replication }}"
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: "{{ confluent_kafka_transaction_replication }}"
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: "1"
      KAFKA_DEFAULT_REPLICATION_FACTOR: "{{ confluent_kafka_default_replication }}"
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "{{ confluent_kafka_auto_create_topics }}"
      KAFKA_LOG_RETENTION_HOURS: "{{ confluent_kafka_log_retention_hours }}"
      KAFKA_JMX_PORT: "9101"
      KAFKA_JMX_HOSTNAME: "kafka"
      KAFKA_HEAP_OPTS: "-Xmx{{ confluent_kafka_heap }} -Xms{{ confluent_kafka_heap }}"
{% if confluent_authorizer_enabled | bool %}
      KAFKA_AUTHORIZER_CLASS_NAME: "{{ confluent_authorizer_class }}"
      KAFKA_SUPER_USERS: "{{ confluent_super_users }}"
      # allow everything on the PLAINTEXT listeners (staging: no auth, but ACL store usable)
      KAFKA_AUTHORIZER_ALLOW_EVERYONE_IF_NO_ACL_IS_FOUND: "true"
{% endif %}
      # Telemetry exporter feeding Control Center Next-Gen via Prometheus
      KAFKA_METRIC_REPORTERS: "io.confluent.telemetry.reporter.TelemetryReporter"
      CONFLUENT_METRICS_REPORTER_BOOTSTRAP_SERVERS: "kafka:{{ confluent_kafka_port_internal }}"
      CONFLUENT_METRICS_ENABLE: "true"
      CONFLUENT_SUPPORT_CUSTOMER_ID: "anonymous"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_TYPE: "http"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_ENABLED: "true"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_CLIENT_BASE_URL: "http://prometheus:{{ confluent_prometheus_port }}/api/v1/otlp"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_METRICS_INCLUDE: "io.confluent.kafka.server.request.(?!.*delta).*|io.confluent.kafka.server.server.broker.state|io.confluent.kafka.server.replica.manager.leader.count|io.confluent.kafka.server.request.queue.size|io.confluent.kafka.server.broker.topic.failed.produce.requests.rate.1.min|io.confluent.kafka.server.tier.archiver.total.lag|io.confluent.kafka.server.request.total.time.ms.p99|io.confluent.kafka.server.broker.topic.failed.fetch.requests.rate.1.min|io.confluent.kafka.server.broker.topic.total.fetch.requests.rate.1.min|io.confluent.kafka.server.partition.caught.up.replicas.count|io.confluent.kafka.server.partition.observer.replicas.count|io.confluent.kafka.server.tier.tasks.num.partitions.in.error|io.confluent.kafka.server.broker.topic.bytes.out.rate.1.min|io.confluent.kafka.server.request.total.time.ms.p95|io.confluent.kafka.server.controller.active.controller.count|io.confluent.kafka.server.broker.topic.total.fetch.requests.rate.1.min|io.confluent.kafka.server.broker.topic.total.produce.requests.rate.1.min|io.confluent.kafka.server.controller.active.broker.count|io.confluent.kafka.server.request.handler.pool.request.handler.avg.idle.percent.rate.1.min|io.confluent.kafka.server.replica.manager.partition.count|io.confluent.kafka.server.controller.unclean.leader.elections.rate.1.min|io.confluent.kafka.server.replica.manager.partition.count|io.confluent.kafka.server.controller.unclean.leader.elections.total|io.confluent.kafka.server.partition.replicas.count|io.confluent.kafka.server.broker.topic.total.produce.requests.rate.1.min|io.confluent.kafka.server.controller.offline.partitions.count|io.confluent.kafka.server.socket.server.network.processor.avg.idle.percent|io.confluent.kafka.server.partition.under.replicated|io.confluent.kafka.server.log.log.start.offset|io.confluent.kafka.server.log.tier.size|io.confluent.kafka.server.log.size|io.confluent.kafka.server.tier.fetcher.bytes.fetched.total|io.confluent.kafka.server.request.total.time.ms.p50|io.confluent.kafka.server.tenant.consumer.lag.offsets|io.confluent.kafka.server.session.expire.listener.zookeeper.disconnects.total|io.confluent.kafka.server.log.log.end.offset|io.confluent.kafka.server.broker.topic.bytes.in.rate.1.min|io.confluent.kafka.server.partition.under.min.isr|io.confluent.kafka.server.partition.in.sync.replicas.count|io.confluent.telemetry.http.exporter.batches.dropped|io.confluent.telemetry.http.exporter.items.total|io.confluent.telemetry.http.exporter.items.succeeded|io.confluent.telemetry.http.exporter.send.time.total.millis|io.confluent.telemetry.http.exporter.batches.failed"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_CLIENT_COMPRESSION: "gzip"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_API_KEY: "dummy"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_API_SECRET: "dummy"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_BUFFER_PENDING_BATCHES_MAX: "80"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_BUFFER_BATCH_ITEMS_MAX: "4000"
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_C3PLUSPLUS_BUFFER_INFLIGHT_SUBMISSIONS_MAX: "10"
      # Single-node cluster: the Kafka exporter side-topic must be RF=1
      KAFKA_CONFLUENT_TELEMETRY_EXPORTER_KAFKA_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_CONFLUENT_METRICS_REPORTER_TOPIC_REPLICAS: "1"
      KAFKA_CONFLUENT_LICENSE_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_CONFLUENT_BALANCER_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_CONFLUENT_TELEMETRY_METRICS_COLLECTOR_INTERVAL_MS: "60000"
      KAFKA_CONFLUENT_TELEMETRY_REMOTECONFIG_CONFLUENT_ENABLED: "false"
      KAFKA_CONFLUENT_CONSUMER_LAG_EMITTER_ENABLED: "true"
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:{{ confluent_kafka_port_internal }} || exit 1"]
      interval: 30s
      timeout: 15s
      retries: 10
      start_period: 60s

  schema-registry:
    image: {{ confluent_image_repo_prefix }}/cp-schema-registry:{{ confluent_version }}
    container_name: schema-registry
    hostname: schema-registry
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    ports:
      - "{{ confluent_schema_registry_port }}:{{ confluent_schema_registry_port }}"
    environment:
      SCHEMA_REGISTRY_HOST_NAME: "schema-registry"
      SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS: "PLAINTEXT://kafka:{{ confluent_kafka_port_internal }}"
      SCHEMA_REGISTRY_LISTENERS: "http://0.0.0.0:{{ confluent_schema_registry_port }}"
      SCHEMA_REGISTRY_HEAP_OPTS: "-Xmx{{ confluent_schema_registry_heap }} -Xms{{ confluent_schema_registry_heap }}"
    healthcheck:
      # cp-schema-registry 8.x images ship neither curl nor cub; probe with java
      test: ["CMD-SHELL", "java -cp /usr/share/java/confluent-common-secure/*.jar:/usr/share/java/confluent-common/*.jar io.confluent.common.security.tools.HttpProbe http://localhost:{{ confluent_schema_registry_port }} 2>/dev/null || (exec 3<>/dev/tcp/localhost/{{ confluent_schema_registry_port }}) || exit 1"]
      interval: 30s
      timeout: 15s
      retries: 10
      start_period: 60s

{% if kafka_ui_enabled | bool %}
  kafka-ui:
    image: {{ kafka_ui_image }}:{{ kafka_ui_version }}
    container_name: kafka-ui
    hostname: kafka-ui
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    ports:
      - "{{ kafka_ui_port }}:8080"
    environment:
      KAFKA_CLUSTERS_0_NAME: "{{ kafka_ui_cluster_name }}"
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: "kafka:{{ confluent_kafka_port_internal }}"
      KAFKA_CLUSTERS_0_SCHEMA_REGISTRY: "http://schema-registry:{{ confluent_schema_registry_port }}"
      KAFKA_CLUSTERS_0_KAFKACONNECT_0_NAME: "connect-default"
      KAFKA_CLUSTERS_0_KAFKACONNECT_0_ADDRESS: "http://connect:{{ confluent_connect_port }}"
      KAFKA_CLUSTERS_0_KSQLDB_URL: "http://ksqldb-server:{{ confluent_ksqldb_port }}"
      DYNAMIC_CONFIG_ENABLED: "true"
      SPRING_CONFIG_ADDITIONAL_LOCATION: "optional:file:/kafka-ui/"

{% endif %}
{% if confluent_connect_enabled | bool %}
  connect:
    image: {{ confluent_image_repo_prefix }}/cp-kafka-connect:{{ confluent_version }}
    container_name: connect
    hostname: connect
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    ports:
      - "{{ confluent_connect_port }}:{{ confluent_connect_port }}"
    environment:
      CONNECT_BOOTSTRAP_SERVERS: "kafka:{{ confluent_kafka_port_internal }}"
      CONNECT_REST_ADVERTISED_HOST_NAME: "connect"
      CONNECT_REST_PORT: "{{ confluent_connect_port }}"
      CONNECT_LISTENERS: "http://0.0.0.0:{{ confluent_connect_port }}"
      CONNECT_GROUP_ID: "{{ confluent_connect_group_id }}"
      CONNECT_CONFIG_STORAGE_TOPIC: "{{ confluent_connect_config_topic }}"
      CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR: "{{ confluent_kafka_default_replication }}"
      CONNECT_OFFSET_STORAGE_TOPIC: "{{ confluent_connect_offset_topic }}"
      CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR: "{{ confluent_kafka_default_replication }}"
      CONNECT_STATUS_STORAGE_TOPIC: "{{ confluent_connect_status_topic }}"
      CONNECT_STATUS_STORAGE_REPLICATION_FACTOR: "{{ confluent_kafka_default_replication }}"
      CONNECT_KEY_CONVERTER: "org.apache.kafka.connect.storage.StringConverter"
      CONNECT_VALUE_CONVERTER: "io.confluent.connect.avro.AvroConverter"
      CONNECT_VALUE_CONVERTER_SCHEMA_REGISTRY_URL: "http://schema-registry:{{ confluent_schema_registry_port }}"
      CONNECT_INTERNAL_KEY_CONVERTER: "org.apache.kafka.connect.json.JsonConverter"
      CONNECT_INTERNAL_VALUE_CONVERTER: "org.apache.kafka.connect.json.JsonConverter"
      CONNECT_OFFSET_FLUSH_INTERVAL_MS: "10000"
      CONNECT_PLUGIN_PATH: "/usr/share/java,/usr/share/confluent-hub-components"
      CONNECT_HEAP_OPTS: "-Xmx{{ confluent_connect_heap }} -Xms{{ confluent_connect_heap }}"
      # Control Center monitoring interceptors
      CONNECT_PRODUCER_INTERCEPTOR_CLASSES: "io.confluent.monitoring.clients.interceptor.MonitoringProducerInterceptor"
      CONNECT_CONSUMER_INTERCEPTOR_CLASSES: "io.confluent.monitoring.clients.interceptor.MonitoringConsumerInterceptor"
    healthcheck:
      # cp-kafka-connect 8.x images ship no curl; probe with bash /dev/tcp
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/localhost/{{ confluent_connect_port }} || exit 1"]
      interval: 30s
      timeout: 15s
      retries: 10
      start_period: 60s

{% endif %}
  kafka-rest:
    image: {{ confluent_image_repo_prefix }}/cp-kafka-rest:{{ confluent_version }}
    container_name: kafka-rest
    hostname: kafka-rest
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
    ports:
      - "{{ confluent_kafka_rest_port }}:{{ confluent_kafka_rest_port }}"
    environment:
      KAFKA_REST_HOST_NAME: "kafka-rest"
      KAFKA_REST_BOOTSTRAP_SERVERS: "PLAINTEXT://kafka:{{ confluent_kafka_port_internal }}"
      KAFKA_REST_LISTENERS: "http://0.0.0.0:{{ confluent_kafka_rest_port }}"
      KAFKA_REST_SCHEMA_REGISTRY_URL: "http://schema-registry:{{ confluent_schema_registry_port }}"

  ksqldb-server:
    image: {{ confluent_image_repo_prefix }}/cp-ksqldb-server:{{ confluent_version }}
    container_name: ksqldb-server
    hostname: ksqldb-server
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
      schema-registry:
        condition: service_started
    ports:
      - "{{ confluent_ksqldb_port }}:{{ confluent_ksqldb_port }}"
    environment:
      KSQL_BOOTSTRAP_SERVERS: "PLAINTEXT://kafka:{{ confluent_kafka_port_internal }}"
      KSQL_HOST_NAME: "ksqldb-server"
      KSQL_LISTENERS: "http://0.0.0.0:{{ confluent_ksqldb_port }}"
      KSQL_KSQL_SCHEMA_REGISTRY_URL: "http://schema-registry:{{ confluent_schema_registry_port }}"
      KSQL_KSQL_SERVICE_ID: "staging_ksql_"
      KSQL_KSQL_STREAMS_STATE_DIR: "/var/lib/ksql"
      KSQL_HEAP_OPTS: "-Xmx{{ confluent_ksqldb_heap }} -Xms{{ confluent_ksqldb_heap }}"
    # ksqlDB refuses to start if the state dir is not writable by the appuser it
    # runs as (uid 1000); the named volume alone is root-owned on first use.
    user: "appuser"
    volumes:
      - ksqldb-data:/var/lib/ksql

  prometheus:
    image: {{ confluent_image_repo_prefix }}/{{ confluent_prometheus_image }}:{{ confluent_prometheus_version }}
    container_name: prometheus
    hostname: prometheus
    restart: unless-stopped
    volumes:
      - {{ confluent_compose_dir }}/config:/mnt/config
    ports:
      - "{{ confluent_prometheus_port }}:{{ confluent_prometheus_port }}"
    environment:
      CONFIG_PATH: "/mnt/config"
      SHOULD_LOG_TO_FILE: "false"

  alertmanager:
    image: {{ confluent_image_repo_prefix }}/{{ confluent_alertmanager_image }}:{{ confluent_alertmanager_version }}
    container_name: alertmanager
    hostname: alertmanager
    restart: unless-stopped
    depends_on:
      - prometheus
    volumes:
      - {{ confluent_compose_dir }}/config:/mnt/config
    ports:
      - "{{ confluent_alertmanager_port }}:9093"
    environment:
      CONFIG_PATH: "/mnt/config"
      SHOULD_LOG_TO_FILE: "false"

  control-center:
    image: {{ confluent_image_repo_prefix }}/{{ confluent_control_center_image }}:{{ confluent_control_center_version }}
    container_name: control-center
    hostname: control-center
    restart: unless-stopped
    depends_on:
      kafka:
        condition: service_healthy
      schema-registry:
        condition: service_started
      prometheus:
        condition: service_started
    volumes:
      - {{ confluent_compose_dir }}/config:/mnt/config
    environment:
      CONTROL_CENTER_BOOTSTRAP_SERVERS: "PLAINTEXT://kafka:{{ confluent_kafka_port_internal }}"
      CONTROL_CENTER_SCHEMA_REGISTRY_URL: "http://schema-registry:{{ confluent_schema_registry_port }}"
{% if confluent_connect_enabled | bool %}
      CONTROL_CENTER_CONNECT_CONNECT-DEFAULT_CLUSTER: "connect:{{ confluent_connect_port }}"
      CONTROL_CENTER_CONNECT_HEALTHCHECK_ENDPOINT: "/connectors"
{% endif %}
      CONTROL_CENTER_KSQL_KSQLDB1_URL: "http://ksqldb-server:{{ confluent_ksqldb_port }}"
      CONTROL_CENTER_KSQL_KSQLDB1_ADVERTISED_URL: "http://{{ confluent_advertised_host }}:{{ confluent_ksqldb_port }}"
      CONTROL_CENTER_REPLICATION_FACTOR: "{{ confluent_kafka_default_replication }}"
      CONTROL_CENTER_INTERNAL_TOPICS_PARTITIONS: "1"
      CONTROL_CENTER_MONITORING_INTERCEPTOR_TOPIC_PARTITIONS: "1"
      CONFLUENT_METRICS_TOPIC_REPLICATION: "{{ confluent_kafka_default_replication }}"
      CONTROL_CENTER_PROMETHEUS_ENABLE: "true"
      CONTROL_CENTER_PROMETHEUS_URL: "http://prometheus:{{ confluent_prometheus_port }}"
      CONTROL_CENTER_PROMETHEUS_RULES_FILE: "/mnt/config/trigger_rules-generated.yml"
      CONTROL_CENTER_ALERTMANAGER_URL: "http://alertmanager:9093"
      CONTROL_CENTER_ALERTMANAGER_CONFIG_FILE: "/mnt/config/alertmanager-generated.yml"
      PORT: "{{ confluent_control_center_port }}"
    ports:
      - "{{ confluent_control_center_port }}:{{ confluent_control_center_port }}"

volumes:
  ksqldb-data:
