# Apache Polaris configuration (Quarkus)
# Generated by Ansible - DO NOT EDIT MANUALLY

# HTTP listener (Iceberg REST catalog API)
quarkus.http.host={{ polaris_host }}
quarkus.http.port={{ polaris_http_port }}

# Management endpoints (health, metrics)
quarkus.management.enabled=true
quarkus.management.host={{ polaris_host }}
quarkus.management.port={{ polaris_metrics_port }}

# Persistence configuration
# in-memory: data lost on restart (development)
# relational: database-backed persistence (production)
polaris.persistence.type={{ polaris_persistence_type }}

# Logging
quarkus.log.level={{ polaris_log_level }}
quarkus.log.file.enabled=true
quarkus.log.file.path={{ polaris_log_dir }}/polaris.log
quarkus.log.file.rotation.max-backup-index={{ polaris_log_max_files }}
quarkus.log.file.rotation.file-suffix=.yyyy-MM-dd
quarkus.log.console.enabled=true
quarkus.log.console.format=%-5p [%d{yyyy-MM-dd HH:mm:ss,SSS}] [%t] %c: %m%n%ex

# Graceful shutdown
quarkus.shutdown.timeout={{ polaris_graceful_shutdown_timeout }}

# CORS (required by Polaris Console)
quarkus.http.cors.enabled={{ polaris_cors_enabled }}
quarkus.http.cors.origins={{ polaris_cors_origins }}
quarkus.http.cors.methods=GET,POST,PUT,DELETE,PATCH,OPTIONS
quarkus.http.cors.headers=Content-Type,Authorization,Polaris-Realm,X-Request-ID
quarkus.http.cors.exposed-headers=*
quarkus.http.cors.access-control-max-age=PT10M

# Bootstrap root principal credentials (fixed, survive restarts)
polaris.bootstrap.credentials={{ polaris_bootstrap_credentials }}
