# Secure Inventory Configuration Template
# Copy this file to inventory/hosts.yml and customize for your environment

all:
  children:
    flink_servers:
      hosts:
        flink-master:
          ansible_host: 10.0.1.10  # Replace with your master server IP
          flink_role: master
          # Optional: Custom memory settings per host
          # flink_jobmanager_heap_size: "2048m"
        flink-worker-1:
          ansible_host: 10.0.1.11  # Replace with your worker server IP
          flink_role: worker
          # Optional: Custom memory settings per host
          # flink_taskmanager_memory_process_size: "4096m"
        flink-worker-2:
          ansible_host: 10.0.1.12  # Replace with your worker server IP
          flink_role: worker
      vars:
        # Security: Use SSH key authentication (recommended)
        ansible_user: ubuntu
        ansible_ssh_private_key_file: ~/.ssh/id_rsa
        
        # Alternative: Use Ansible Vault for password authentication
        # ansible_user: user
        # ansible_password: "{{ vault_ansible_password }}"
        
        # Privilege escalation
        ansible_become: true
        ansible_become_method: sudo
        
        # Alternative: Use Ansible Vault for sudo password
        # ansible_become_password: "{{ vault_ansible_become_password }}"
        
        # SSH connection optimization
        ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
        
        # Connection settings
        ansible_connection: ssh
        ansible_python_interpreter: /usr/bin/python3
        
        # Optional: Custom variables per environment
        # flink_log_level: "INFO"
        # flink_checkpointing_interval: "10000"